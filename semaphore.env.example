# Copy to semaphore.env (gitignored) and fill in. Do not commit secrets.
SEMAPHORE_URL=https://sp.sysplore.com
SEMAPHORE_API_TOKEN=

SEMAPHORE_PROJECT=harden-linux
SEMAPHORE_REPO_URL=https://github.com/sysplore/harden-linux.git
SEMAPHORE_REPO_BRANCH=main
SEMAPHORE_REPO_NAME=harden-linux

SEMAPHORE_SSH_KEY_FILE=~/.ssh/id_ed25519
SEMAPHORE_SSH_KEY_PASSPHRASE=
SEMAPHORE_SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
# Or inline the public key:
# SEMAPHORE_SSH_PUBLIC_KEY=ssh-ed25519 AAAA...
SEMAPHORE_SSH_LOGIN=ansible
# Optional: seed hosts from a file. Leave empty to create only the
# linux/debian/ubuntu group structure; add hosts in Semaphore afterwards.
SEMAPHORE_INVENTORY_FILE=
SEMAPHORE_INVENTORY_NAME=linux-ansible
SEMAPHORE_ENV_NAME=harden

# Optional: create a one-time bootstrap credential and inventory.
SEMAPHORE_BOOTSTRAP_LOGIN=root
SEMAPHORE_BOOTSTRAP_PASSWORD=

# Optional: sudo password for the ansible user. Used as an environment secret.
SEMAPHORE_BECOME_PASSWORD=
